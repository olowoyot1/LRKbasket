generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id         String      @id @default(cuid())
  name       String
  category   String
  price      Int // price in whole naira (NGN)
  unit       String
  tag        String
  icon       String
  color      String
  imageUrl   String?
  stock      Int         @default(0)
  createdAt  DateTime    @default(now())
  orderItems OrderItem[]
}

// Singleton row (id is always "settings") holding editable store-wide settings.
model Settings {
  id                    String @id @default("settings")
  deliveryFee           Int    @default(1500)
  freeDeliveryThreshold Int    @default(15000)
}

model Order {
  id           String      @id @default(cuid())
  reference    String      @unique
  customerName String
  email        String
  phone        String
  address      String
  subtotal     Int
  deliveryFee  Int
  total        Int
  status       OrderStatus @default(PENDING)
  channel      OrderChannel @default(PAYSTACK)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  name      String
  price     Int
  qty       Int
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum OrderChannel {
  PAYSTACK
  WHATSAPP
}
