generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String       @id @default(cuid())
  name        String
  category    String
  price       Int // price in whole naira (NGN)
  unit        String
  tag         String
  icon        String
  color       String
  imageUrl    String?
  stock       Int          @default(0)
  createdAt   DateTime     @default(now())
  orderItems  OrderItem[]
  bundleItems BundleItem[]
}

// A pre-assembled kit of products sold as one line item at its own price -
// e.g. a "Soup Starter Pack" containing several individual products.
model Bundle {
  id                      String       @id @default(cuid())
  name                    String
  description             String
  price                   Int // bundle price in whole naira
  imageUrl                String?
  tag                     String       @default("Bundle")
  color                   String       @default("purple")
  active                  Boolean      @default(true)
  // Group-buy: once `groupBuyTarget` units have been ordered (across all
  // non-failed orders), the price drops by `groupBuyDiscountPercent` for
  // every order placed after that point. This is prospective, not
  // retroactive - early orders pay full price. See README for the tradeoff.
  groupBuyEnabled         Boolean      @default(false)
  groupBuyTarget          Int          @default(0)
  groupBuyDiscountPercent Int          @default(0)
  createdAt               DateTime     @default(now())
  items                   BundleItem[]
  orderItems              OrderItem[]
}

model BundleItem {
  id        String  @id @default(cuid())
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  bundleId  String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  qty       Int
}

// Singleton row (id is always "settings") holding editable store-wide settings.
model Settings {
  id                    String @id @default("settings")
  deliveryFee           Int    @default(1500)
  freeDeliveryThreshold Int    @default(15000)
}

model Order {
  id           String       @id @default(cuid())
  reference    String       @unique
  customerName String
  email        String
  phone        String
  address      String
  subtotal     Int
  deliveryFee  Int
  total        Int
  status       OrderStatus  @default(PENDING)
  channel      OrderChannel @default(PAYSTACK)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        OrderItem[]
}

// A line item is either a product OR a bundle (never both, never neither) -
// productId/bundleId are optional so one relation is set and the other null.
model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  bundle    Bundle?  @relation(fields: [bundleId], references: [id])
  bundleId  String?
  name      String
  price     Int
  qty       Int
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum OrderChannel {
  PAYSTACK
  WHATSAPP
}
